<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Crystal Ball</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background: linear-gradient(to bottom, #0d0d12 0%, #1a1a25 100%);
            font-family: sans-serif;
        }
        canvas {
            display: block;
            touch-action: none;
        }
        #loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: rgba(255, 255, 255, 0.7);
            pointer-events: none;
        }
    </style>
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>
</head>
<body>
    <div id="loading">Загрузка...</div>

    <script type="module">
        import * as THREE from 'three';

        // === СЦЕНА ===
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x0d0d12, 0.02);

        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.set(0, 0.5, 7);
        camera.lookAt(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.3;
        document.body.appendChild(renderer.domElement);

        // === ОСВЕЩЕНИЕ ===
        const ambientLight = new THREE.AmbientLight(0xffaa66, 0.5);
        scene.add(ambientLight);

        // Тёплые свечи
        const candleLights = [];
        const candleData = [
            { x: -5, y: 3, z: -5, color: 0xffaa44, intensity: 120 },
            { x: 5, y: 2.5, z: -6, color: 0xffcc66, intensity: 100 },
            { x: 0, y: 4, z: -7, color: 0xffdd88, intensity: 80 },
            { x: -3, y: 2, z: -4, color: 0xff9944, intensity: 90 },
            { x: 4, y: 3.5, z: -5, color: 0xffbb55, intensity: 110 }
        ];

        candleData.forEach((data, i) => {
            const light = new THREE.PointLight(data.color, data.intensity, 20);
            light.position.set(data.x, data.y, data.z);
            scene.add(light);
            candleLights.push({
                light,
                baseIntensity: data.intensity,
                flickerSpeed: 0.002 + Math.random() * 0.003,
                offset: i * 1.5
            });
        });

        // Основной свет на шар
        const mainLight = new THREE.PointLight(0xffffff, 80, 15);
        mainLight.position.set(4, 5, 6);
        scene.add(mainLight);

        const fillLight = new THREE.PointLight(0x88aaff, 30, 12);
        fillLight.position.set(-4, 3, 4);
        scene.add(fillLight);

        // === ФОНОВЫЕ БОКЕ (свечи) ===
        const bgBokehGroup = new THREE.Group();

        function createBokehTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');
            const grad = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
            grad.addColorStop(0, 'rgba(255, 200, 100, 0.8)');
            grad.addColorStop(0.3, 'rgba(255, 150, 50, 0.4)');
            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 128, 128);
            return new THREE.CanvasTexture(canvas);
        }

        const bokehTex = createBokehTexture();
        const bokehMat = new THREE.SpriteMaterial({
            map: bokehTex,
            color: 0xffcc88,
            transparent: true,
            opacity: 0.6,
            blending: THREE.AdditiveBlending,
            depthTest: false
        });

        const bokehPositions = [
            { x: -5, y: 3.5, z: -8, scale: 0.8, color: 0xffaa66 },
            { x: -4.5, y: 3.2, z: -8.5, scale: 0.6, color: 0xffcc88 },
            { x: 5, y: 3, z: -9, scale: 0.9, color: 0xffdd99 },
            { x: 4.5, y: 2.8, z: -8.5, scale: 0.7, color: 0xffbb77 },
            { x: 0, y: 4.5, z: -10, scale: 0.75, color: 0xffeeaa }
        ];

        bokehPositions.forEach(pos => {
            const sprite = new THREE.Sprite(bokehMat.clone());
            sprite.material.color.setHex(pos.color);
            sprite.material.opacity = 0.5 + Math.random() * 0.3;
            sprite.scale.set(pos.scale, pos.scale, 1);
            sprite.position.set(pos.x, pos.y, pos.z);
            sprite.userData = { baseScale: pos.scale, flickerSpeed: 0.001 + Math.random() * 0.002 };
            bgBokehGroup.add(sprite);
        });
        scene.add(bgBokehGroup);

        // === ПОДСТАВКА ===
        const baseGroup = new THREE.Group();

        const baseMat = new THREE.MeshStandardMaterial({
            color: 0x3a3a4a,
            metalness: 0.8,
            roughness: 0.25,
            emissive: 0x2a2a3a,
            emissiveIntensity: 0.15
        });

        const bronzeMat = new THREE.MeshStandardMaterial({
            color: 0x8b6f47,
            metalness: 0.9,
            roughness: 0.2,
            emissive: 0x4a3a2a,
            emissiveIntensity: 0.2
        });

        // Основание
        const baseBottomGeom = new THREE.CylinderGeometry(1.4, 1.6, 0.35, 48);
        const baseBottom = new THREE.Mesh(baseBottomGeom, baseMat);
        baseBottom.position.y = -1.5;
        baseGroup.add(baseBottom);

        // Средний ярус
        const baseMiddleGeom = new THREE.CylinderGeometry(1.0, 1.4, 0.45, 48);
        const baseMiddle = new THREE.Mesh(baseMiddleGeom, bronzeMat);
        baseMiddle.position.y = -1.2;
        baseGroup.add(baseMiddle);

        // Верхний ярус
        const baseTopGeom = new THREE.CylinderGeometry(0.7, 1.0, 0.3, 48);
        const baseTop = new THREE.Mesh(baseTopGeom, bronzeMat);
        baseTop.position.y = -0.9;
        baseGroup.add(baseTop);

        // Декоративные кольца
        for (let i = 0; i < 3; i++) {
            const ringGeom = new THREE.TorusGeometry(0.85 - i * 0.15, 0.035, 16, 64);
            const ring = new THREE.Mesh(ringGeom, bronzeMat);
            ring.rotation.x = Math.PI / 2;
            ring.position.y = -0.75 - i * 0.12;
            baseGroup.add(ring);
        }

        scene.add(baseGroup);

        // === ХРУСТАЛЬНЫЙ ШАР ===
        const ballGroup = new THREE.Group();
        const baseRadius = 1.0;

        // Используем MeshStandardMaterial с прозрачностью для совместимости
        const sphereGeom = new THREE.SphereGeometry(baseRadius, 64, 64);
        const sphereMat = new THREE.MeshStandardMaterial({
            color: 0xffffff,
            metalness: 0.1,
            roughness: 0.03,
            transparent: true,
            opacity: 0.35,
            envMapIntensity: 2.5,
            side: THREE.DoubleSide,
            depthWrite: false,
            depthTest: true
        });

        const crystalBall = new THREE.Mesh(sphereGeom, sphereMat);
        ballGroup.add(crystalBall);

        // Внутренние звёзды (5 главных)
        const innerStars = new THREE.Group();

        function createStarTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');

            // Яркий центр
            const grad = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
            grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
            grad.addColorStop(0.1, 'rgba(255, 255, 220, 0.95)');
            grad.addColorStop(0.2, 'rgba(255, 240, 180, 0.8)');
            grad.addColorStop(0.35, 'rgba(255, 200, 120, 0.5)');
            grad.addColorStop(0.6, 'rgba(255, 150, 80, 0.2)');
            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');

            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 128, 128);

            // Лучи звезды
            ctx.strokeStyle = 'rgba(255, 255, 230, 0.5)';
            ctx.lineWidth = 1.5;
            for (let i = 0; i < 8; i++) {
                const angle = (i / 8) * Math.PI * 2;
                ctx.beginPath();
                ctx.moveTo(64, 64);
                ctx.lineTo(64 + Math.cos(angle) * 55, 64 + Math.sin(angle) * 55);
                ctx.stroke();
            }

            return new THREE.CanvasTexture(canvas);
        }

        const starTex = createStarTexture();
        const starMat = new THREE.SpriteMaterial({
            map: starTex,
            color: 0xffffee,
            transparent: true,
            alphaTest: 0.02,
            depthWrite: false,
            depthTest: true,
            blending: THREE.AdditiveBlending
        });

        const starPositions = [
            { x: 0.35, y: 0.45, z: 0.25, scale: 0.42 },
            { x: -0.45, y: -0.25, z: 0.35, scale: 0.38 },
            { x: 0.15, y: -0.55, z: -0.35, scale: 0.48 },
            { x: -0.25, y: 0.35, z: -0.45, scale: 0.35 },
            { x: 0.55, y: 0.15, z: -0.25, scale: 0.4 }
        ];

        starPositions.forEach((pos, i) => {
            const star = new THREE.Sprite(starMat);
            star.position.set(pos.x * 0.75, pos.y * 0.75, pos.z * 0.75);
            star.scale.set(pos.scale, pos.scale, 1);
            star.userData = { baseScale: pos.scale, offset: i * 0.9, twinkleSpeed: 0.002 + Math.random() * 0.002 };
            innerStars.add(star);
        });

        crystalBall.add(innerStars);

        // Множество мелких искр внутри шара
        const sparkles = new THREE.Group();
        const sparkleMat = new THREE.PointsMaterial({
            color: 0xffffee,
            size: 0.025,
            transparent: true,
            opacity: 0.9,
            blending: THREE.AdditiveBlending,
            depthWrite: false
        });

        const sparkleGeom = new THREE.BufferGeometry();
        const sparkleCount = 150;
        const sparklePositions = new Float32Array(sparkleCount * 3);
        const sparkleSizes = new Float32Array(sparkleCount);

        for (let i = 0; i < sparkleCount; i++) {
            const i3 = i * 3;
            const r = 0.7 * Math.cbrt(Math.random());
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1);
            sparklePositions[i3] = r * Math.sin(phi) * Math.cos(theta);
            sparklePositions[i3 + 1] = r * Math.sin(phi) * Math.sin(theta);
            sparklePositions[i3 + 2] = r * Math.cos(phi);
            sparkleSizes[i] = 0.5 + Math.random() * 0.5;
        }

        sparkleGeom.setAttribute('position', new THREE.BufferAttribute(sparklePositions, 3));
        sparkleGeom.setAttribute('size', new THREE.BufferAttribute(sparkleSizes, 1));
        const sparkleSystem = new THREE.Points(sparkleGeom, sparkleMat);
        sparkles.add(sparkleSystem);
        crystalBall.add(sparkles);

        ballGroup.add(crystalBall);
        scene.add(ballGroup);

        // === ПЫЛИНКИ (3 шт) ===
        const dustParticles = [];
        const dustMat = new THREE.SpriteMaterial({
            color: 0xffffee,
            transparent: true,
            opacity: 0.4,
            sizeAttenuation: true,
            depthTest: false,
            blending: THREE.AdditiveBlending
        });

        for (let i = 0; i < 3; i++) {
            const dust = new THREE.Sprite(dustMat);
            dust.scale.set(0.04, 0.04, 1);
            dust.position.set(
                (Math.random() - 0.5) * 12,
                (Math.random() - 0.5) * 8,
                (Math.random() - 0.5) * 6
            );
            scene.add(dust);

            dust.userData = {
                velocity: new THREE.Vector3(
                    (Math.random() - 0.5) * 0.015,
                    (Math.random() - 0.5) * 0.01,
                    (Math.random() - 0.5) * 0.008
                ),
                baseOpacity: 0.25 + Math.random() * 0.25,
                offset: i * 2
            };
            dustParticles.push(dust);
        }

        // === УПРАВЛЕНИЕ ===
        let isZoomed = false;
        let isDragging = false;
        let dragStart = { x: 0, y: 0 };
        let prev = { x: 0, y: 0 };
        let rotVel = { x: 0.001, y: 0.002 };
        const damping = 0.96;
        const sens = 0.005;

        function toggleZoom() {
            isZoomed = !isZoomed;
            const targetScale = isZoomed ? 2.0 : 1.0;
            const startScale = ballGroup.scale.x;
            const duration = 350;
            const startTime = performance.now();

            function animateScale() {
                const elapsed = performance.now() - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const ease = 1 - Math.pow(1 - progress, 3);
                const current = startScale + (targetScale - startScale) * ease;
                ballGroup.scale.set(current, current, current);
                if (progress < 1) requestAnimationFrame(animateScale);
            }
            animateScale();
        }

        const onStart = (e) => {
            const cx = e.touches ? e.touches[0].clientX : e.clientX;
            const cy = e.touches ? e.touches[0].clientY : e.clientY;
            dragStart = { x: cx, y: cy };
            prev = { x: cx, y: cy };
            isDragging = true;
        };

        const onMove = (e) => {
            if (!isDragging) return;
            const cx = e.touches ? e.touches[0].clientX : e.clientX;
            const cy = e.touches ? e.touches[0].clientY : e.clientY;
            const dx = cx - prev.x;
            const dy = cy - prev.y;
            ballGroup.rotation.y += dx * sens;
            ballGroup.rotation.x += dy * sens;
            innerStars.rotation.y += dx * sens;
            innerStars.rotation.x += dy * sens;
            sparkles.rotation.y += dx * sens;
            sparkles.rotation.x += dy * sens;
            rotVel.x = dy * sens;
            rotVel.y = dx * sens;
            prev = { x: cx, y: cy };
        };

        const onEnd = (e) => {
            isDragging = false;
            const cx = e.changedTouches ? e.changedTouches[0].clientX : e.clientX;
            const cy = e.changedTouches ? e.changedTouches[0].clientY : e.clientY;
            const dx = Math.abs(cx - dragStart.x);
            const dy = Math.abs(cy - dragStart.y);
            if (dx < 8 && dy < 8) toggleZoom();
        };

        document.addEventListener('mousedown', onStart);
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onEnd);
        document.addEventListener('touchstart', onStart, { passive: false });
        document.addEventListener('touchmove', onMove, { passive: false });
        document.addEventListener('touchend', onEnd);

        // === АНИМАЦИЯ ===
        function animate() {
            requestAnimationFrame(animate);
            const time = Date.now() * 0.001;

            // Мерцание свечей
            candleLights.forEach((candle, i) => {
                candle.light.intensity = candle.baseIntensity +
                    Math.sin(time * 8 + candle.offset) * 15 +
                    Math.sin(time * 12 + candle.offset * 1.3) * 10;
            });

            // Мерцание боке
            bgBokehGroup.children.forEach((sprite, i) => {
                sprite.material.opacity = 0.4 + Math.sin(time * 2 + i) * 0.2;
                const scale = sprite.userData.baseScale + Math.sin(time * 1.5 + i) * 0.05;
                sprite.scale.set(scale, scale, 1);
            });

            // Вращение по инерции
            if (!isDragging) {
                ballGroup.rotation.y += rotVel.y;
                ballGroup.rotation.x += rotVel.x;
                innerStars.rotation.y += rotVel.y;
                innerStars.rotation.x += rotVel.x;
                sparkles.rotation.y += rotVel.y;
                sparkles.rotation.x += rotVel.x;
                rotVel.x *= damping;
                rotVel.y *= damping;
                if (Math.abs(rotVel.x) < 0.0001 && Math.abs(rotVel.y) < 0.0001) {
                    ballGroup.rotation.y += 0.0002;
                    innerStars.rotation.y += 0.0002;
                    sparkles.rotation.y += 0.0002;
                }
            }

            // Пульсация главных звёзд
            innerStars.children.forEach((star, i) => {
                const twinkle = Math.sin(time * 3 + star.userData.offset) * 0.2;
                const scale = star.userData.baseScale + twinkle;
                star.scale.set(scale, scale, 1);
                star.material.opacity = 0.75 + Math.sin(time * 4 + i) * 0.2;
            });

            // Мерцание искр
            sparkleMat.opacity = 0.7 + Math.sin(time * 5) * 0.2;

            // Пылинки
            dustParticles.forEach((dust, i) => {
                dust.position.add(dust.userData.velocity);
                if (Math.abs(dust.position.x) > 9) dust.userData.velocity.x *= -1;
                if (Math.abs(dust.position.y) > 6) dust.userData.velocity.y *= -1;
                if (Math.abs(dust.position.z) > 5) dust.userData.velocity.z *= -1;
                dust.material.opacity = dust.userData.baseOpacity + Math.sin(time * 2 + dust.userData.offset) * 0.1;
            });

            // Лёгкое покачивание
            if (!isDragging) {
                ballGroup.position.y = Math.sin(time * 0.4) * 0.015;
                baseGroup.position.y = Math.sin(time * 0.4) * 0.015;
            }

            renderer.render(scene, camera);
        }

        document.getElementById('loading').style.display = 'none';
        animate();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>

