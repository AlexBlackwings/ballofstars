<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Crystal Sphere</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background: #000;
            font-family: sans-serif;
        }
        canvas {
            display: block;
            touch-action: none;
        }
        #loading {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            color: rgba(255,255,255,0.6);
        }
    </style>
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>
</head>
<body>
    <div id="loading">Загрузка...</div>

    <script type="module">
        import * as THREE from 'three';

        // --- Сцена ---
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.z = 12;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        document.body.appendChild(renderer.domElement);

        // === 1. ФОН: звёздное небо (для искажения через шар) ===
        const bgGeometry = new THREE.PlaneGeometry(20, 20);
        const bgMaterial = new THREE.MeshBasicMaterial({
            color: 0x050510,
            side: THREE.BackSide
        });
        const bg = new THREE.Mesh(bgGeometry, bgMaterial);
        bg.position.z = -15;
        scene.add(bg);

        // Добавим 200 фоновых звёзд (точки)
        const starField = new THREE.BufferGeometry();
        const starCount = 200;
        const positions = new Float32Array(starCount * 3);
        const colors = new Float32Array(starCount * 3);

        for (let i = 0; i < starCount; i++) {
            const i3 = i * 3;
            // Распределение по сфере радиуса 10–15
            const r = 10 + Math.random() * 5;
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1);
            positions[i3]     = r * Math.sin(phi) * Math.cos(theta);
            positions[i3 + 1] = r * Math.sin(phi) * Math.sin(theta);
            positions[i3 + 2] = r * Math.cos(phi);

            const brightness = 0.5 + Math.random() * 0.5;
            colors[i3]     = brightness * 0.6;
            colors[i3 + 1] = brightness * 0.7;
            colors[i3 + 2] = brightness * 1.0;
        }

        starField.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        starField.setAttribute('color', new THREE.BufferAttribute(colors, 3));

        const starMat = new THREE.PointsMaterial({
            size: 0.05,
            sizeAttenuation: false,
            vertexColors: true,
            transparent: true,
            opacity: 0.8
        });
        const stars = new THREE.Points(starField, starMat);
        scene.add(stars);

        // === 2. ПЫЛИНКИ (в "воздухе") ===
        const dustGroup = new THREE.Group();
        const dustCount = 30;
        for (let i = 0; i < dustCount; i++) {
            const r = 1.5 + Math.random() * 4; // от 1.5 до 5.5
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1);
            const x = r * Math.sin(phi) * Math.cos(theta);
            const y = r * Math.sin(phi) * Math.sin(theta);
            const z = r * Math.cos(phi);

            const dust = new THREE.Sprite(new THREE.SpriteMaterial({
                color: 0xffffff,
                transparent: true,
                opacity: 0.4 + Math.random() * 0.3,
                sizeAttenuation: false
            }));
            dust.position.set(x, y, z);
            dust.scale.set(0.02 + Math.random() * 0.03, 0.02 + Math.random() * 0.03, 1);
            dust.userData = {
                speed: 0.001 + Math.random() * 0.002,
                angle: Math.random() * Math.PI * 2
            };
            dustGroup.add(dust);
        }
        scene.add(dustGroup);

        // === 3. ЗВЁЗДОЧКИ ВНУТРИ ШАРА ===
        const innerStars = new THREE.Group();

        function createStarTex() {
            const c = document.createElement('canvas');
            c.width = c.height = 64;
            const ctx = c.getContext('2d');
            const g = ctx.createRadialGradient(32,32,0,32,32,32);
            g.addColorStop(0, 'rgba(255,255,200,1)');
            g.addColorStop(0.4, 'rgba(255,200,100,0.8)');
            g.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = g;
            ctx.fillRect(0,0,64,64);
            return new THREE.CanvasTexture(c);
        }

        const starTex = createStarTex();
        const innerStarMat = new THREE.SpriteMaterial({
            map: starTex,
            color: 0xffffcc,
            transparent: true,
            alphaTest: 0.1,
            depthWrite: false,
            blending: THREE.AdditiveBlending
        });

        for (let i = 0; i < 5; i++) {
            const r = 0.6 * Math.cbrt(Math.random());
            const t = Math.random() * Math.PI * 2;
            const p = Math.acos(2 * Math.random() - 1);
            const x = r * Math.sin(p) * Math.cos(t);
            const y = r * Math.sin(p) * Math.sin(t);
            const z = r * Math.cos(p);

            const s = new THREE.Sprite(innerStarMat);
            s.position.set(x, y, z);
            s.scale.set(0.25 + Math.random() * 0.1, 0.25 + Math.random() * 0.1, 1);
            innerStars.add(s);
        }

        // === 4. КРИСТАЛЬНЫЙ ШАР — через ShaderMaterial ===
        const radius = 1.0; // базовый радиус (в 3× меньше исходного)
        const sphereGeom = new THREE.SphereGeometry(radius, 64, 64);

        // Шейдер для преломления и бликов
        const crystalShader = {
            uniforms: {
                uTime: { value: 0 },
                uZoom: { value: 1.0 }, // 1.0 = удалён, 2.0 = приближён
                uInnerStars: { value: [] }, // позиции звёзд для бликов
                uResolution: { value: new THREE.Vector2() }
            },
            vertexShader: `
                varying vec3 vNormal;
                varying vec3 vPosition;
                void main() {
                    vNormal = normalize(normalMatrix * normal);
                    vPosition = (instanceMatrix * vec4(position, 1.0)).xyz;
                    vec3 transformed = (vec4(position, 1.0) * worldMatrix).xyz;
                    gl_Position = projectionMatrix * modelViewMatrix * vec4(transformed, 1.0);
                }
            `,
            fragmentShader: `
                uniform float uTime;
                uniform float uZoom;
                uniform vec3 uInnerStars[5];
                uniform vec2 uResolution;

                varying vec3 vNormal;
                varying vec3 vPosition;

                // Простая функция для имитации преломления
                vec3 refractRay(vec3 rayDir, vec3 normal, float eta) {
                    float cosI = dot(-rayDir, normal);
                    float k = 1.0 - eta * eta * (1.0 - cosI * cosI);
                    return eta * rayDir + (eta * cosI - sqrt(max(0.0, k))) * normal;
                }

                void main() {
                    vec2 uv = gl_FragCoord.xy / uResolution;
                    vec3 viewDir = normalize(cameraPosition - vPosition);
                    vec3 normal = normalize(vNormal);

                    // Блик от внутренних звёзд
                    vec3 highlight = vec3(0.0);
                    for (int i = 0; i < 5; i++) {
                        vec3 starDir = normalize(uInnerStars[i] - vPosition);
                        float dotNV = max(0.0, dot(normal, starDir));
                        highlight += pow(dotNV, 32.0) * vec3(1.0, 0.9, 0.7) * 0.8;
                    }

                    // Преломлённый фон (упрощённо: искажение uv)
                    vec2 distortedUv = uv + 0.02 * normal.xy * (1.0 - abs(normal.z)) * sin(uTime * 0.5);
                    distortedUv = clamp(distortedUv, 0.0, 1.0);

                    // Цвет фона (имитируем звёздное небо)
                    vec3 bgColor = vec3(0.05, 0.05, 0.15);
                    vec3 starPattern = vec3(
                        sin(distortedUv.x * 20.0 + uTime) * 0.1,
                        cos(distortedUv.y * 30.0 - uTime) * 0.08,
                        sin(distortedUv.x * 15.0 + distortedUv.y * 12.0) * 0.05
                    );
                    bgColor += starPattern * 0.3;

                    // Основной цвет шара: прозрачный, с бликами
                    vec3 baseColor = vec3(0.9, 0.95, 1.0) * 0.1;
                    vec3 finalColor = mix(bgColor, baseColor, 0.3) + highlight * 0.6;

                    // Прозрачность: зависит от угла взгляда (Fresnel)
                    float fresnel = pow(1.0 - abs(dot(viewDir, normal)), 3.0);
                    float opacity = 0.4 + fresnel * 0.5;

                    gl_FragColor = vec4(finalColor, opacity);
                }
            `
        };

        // Заполняем uniforms звёздами
        const starPositions = [];
        innerStars.children.forEach(s => starPositions.push(s.position.clone()));
        crystalShader.uniforms.uInnerStars.value = starPositions;

        const crystalMat = new THREE.ShaderMaterial({
            uniforms: crystalShader.uniforms,
            vertexShader: crystalShader.vertexShader,
            fragmentShader: crystalShader.fragmentShader,
            transparent: true,
            depthWrite: false,
            depthTest: true,
            side: THREE.DoubleSide
        });

        const sphere = new THREE.Mesh(sphereGeom, crystalMat);
        sphere.add(innerStars);
        scene.add(sphere);

        // === Управление масштабом ===
        let isZoomed = false;
        let isDragging = false;
        let dragStart = { x: 0, y: 0 };
        let prev = { x: 0, y: 0 };
        let rotVel = { x: 0.002, y: 0.003 };
        const damping = 0.96;
        const sens = 0.005;

        function toggleZoom() {
            isZoomed = !isZoomed;
            const targetScale = isZoomed ? 2.0 : 1.0;
            sphere.scale.set(targetScale, targetScale, targetScale);
            crystalMat.uniforms.uZoom.value = targetScale;
        }

        const onStart = (e) => {
            const cx = e.touches ? e.touches[0].clientX : e.clientX;
            const cy = e.touches ? e.touches[0].clientY : e.clientY;
            dragStart = { x: cx, y: cy };
            prev = { x: cx, y: cy };
            isDragging = true;
        };

        const onMove = (e) => {
            if (!isDragging) return;
            const cx = e.touches ? e.touches[0].clientX : e.clientX;
            const cy = e.touches ? e.touches[0].clientY : e.clientY;

            const dx = cx - prev.x;
            const dy = cy - prev.y;

            const q = new THREE.Quaternion().setFromEuler(
                new THREE.Euler(dy * sens, dx * sens, 0, 'XYZ')
            );

            sphere.quaternion.multiplyQuaternions(q, sphere.quaternion);
            innerStars.quaternion.multiplyQuaternions(q, innerStars.quaternion);

            rotVel.x = dy * sens;
            rotVel.y = dx * sens;
            prev = { x: cx, y: cy };
        };

        const onEnd = (e) => {
            isDragging = false;
            const cx = e.touches ? e.touches[0].clientX : e.clientX;
            const cy = e.touches ? e.touches[0].clientY : e.clientY;
            const dx = Math.abs(cx - dragStart.x);
            const dy = Math.abs(cy - dragStart.y);
            if (dx < 5 && dy < 5) toggleZoom();
        };

        document.addEventListener('mousedown', onStart);
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onEnd);
        document.addEventListener('touchstart', onStart, { passive: false });
        document.addEventListener('touchmove', onMove, { passive: false });
        document.addEventListener('touchend', onEnd);

        // === Анимация ===
        function animate(time) {
            requestAnimationFrame(animate);

            crystalMat.uniforms.uTime.value = time * 0.001;
            crystalMat.uniforms.uResolution.value.set(window.innerWidth, window.innerHeight);

            if (!isDragging) {
                sphere.rotation.y += rotVel.y;
                sphere.rotation.x += rotVel.x;
                innerStars.rotation.y += rotVel.y;
                innerStars.rotation.x += rotVel.x;

                rotVel.x *= damping;
                rotVel.y *= damping;

                if (Math.abs(rotVel.x) < 0.0001 && Math.abs(rotVel.y) < 0.0001) {
                    sphere.rotation.y += 0.0006;
                    innerStars.rotation.y += 0.0006;
                }
            }

            // Пылинки
            dustGroup.children.forEach(dust => {
                dust.userData.angle += dust.userData.speed;
                dust.position.x = Math.cos(dust.userData.angle) * 3;
                dust.position.z = Math.sin(dust.userData.angle) * 3;
                dust.position.y += 0.001;
                if (dust.position.y > 2) dust.position.y = -2;
            });

            // Пульсация звёзд внутри
            innerStars.children.forEach((s, i) => {
                s.material.opacity = 0.6 + Math.sin(time * 0.002 + i) * 0.3;
            });

            renderer.render(scene, camera);
        }

        document.getElementById('loading').style.display = 'none';
        animate(0);

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
